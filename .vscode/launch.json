{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GDB: Launch Main Program",
      "type": "cppdbg",
      "request": "launch",
      "preLaunchTask": "Build: Debug Mode",
      "program": "${workspaceFolder}/output/bin/mssanitizer.bin",
      "args": [
          "--tool=${input:toolType}",
          "--",
          "bash",
          "${input:scriptPath}"
      ],
      "stopAtEntry": true,
      "cwd": "${workspaceFolder}/output/bin",
      "environment": [
        {
          "name": "LD_LIBRARY_PATH",
          "value": "${workspaceFolder}/output/lib64:${env:LD_LIBRARY_PATH}"
        },
        {
          "name": "LD_PRELOAD_PATH",
          "value": "${workspaceFolder}/output/lib64"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "为 gdb 启用整齐打印",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "设置反汇编风格为 Intel",
          "text": "-gdb-set disassembly-flavor intel",
          "ignoreFailures": true
        },
        {
          "description": "跟踪父进程 (fork 后)",
          "text": "-gdb-set follow-fork-mode parent",
          "ignoreFailures": true
        },
        {
          "description": "fork 后分离子进程",
          "text": "-gdb-set detach-on-fork on",
          "ignoreFailures": true
        },
        {
          "description": "允许挂起断点",
          "text": "set breakpoint pending on",
          "ignoreFailures": true
        }
      ],
      "logging": {
        "moduleLoad": false,
        "trace": false,
        "engineLogging": false,
        "programOutput": true,
        "exceptions": true
      }
    },
    {
      "name": "GDB: Launch Main Program (Child Process Tracking)",
      "type": "cppdbg",
      "request": "launch",
      "preLaunchTask": "Build: Debug Mode",
      "program": "${workspaceFolder}/output/bin/mssanitizer.bin",
      "args": [
          "--tool=${input:toolType}",
          "--",
          "bash",
          "${input:scriptPath}"
      ],
      "stopAtEntry": true,
      "cwd": "${workspaceFolder}/output/bin",
      "environment": [
        {
          "name": "LD_LIBRARY_PATH",
          "value": "${workspaceFolder}/output/lib64:${env:LD_LIBRARY_PATH}"
        },
        {
          "name": "LD_PRELOAD_PATH",
          "value": "${workspaceFolder}/output/lib64"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "为 gdb 启用整齐打印",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "设置反汇编风格为 Intel",
          "text": "-gdb-set disassembly-flavor intel",
          "ignoreFailures": true
        },
        {
          "description": "跟踪子进程 (fork 后自动切换到子进程)",
          "text": "-gdb-set follow-fork-mode child",
          "ignoreFailures": true
        },
        {
          "description": "fork 后分离父进程",
          "text": "-gdb-set detach-on-fork on",
          "ignoreFailures": true
        },
        {
          "description": "允许挂起断点",
          "text": "set breakpoint pending on",
          "ignoreFailures": true
        },
        {
          "description": "在共享库加载事件时暂停",
          "text": "set stop-on-solib-events 1",
          "ignoreFailures": true
        }
      ],
      "logging": {
        "moduleLoad": false,
        "trace": false,
        "engineLogging": false,
        "programOutput": true,
        "exceptions": true
      }
    },
    {
      "name": "GDB: Attach to Running Process",
      "type": "cppdbg",
      "request": "attach",
      "program": "${workspaceFolder}/output/bin/mssanitizer.bin",
      "processId": "${command:pickProcess}",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "为 gdb 启用整齐打印",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "设置反汇编风格为 Intel",
          "text": "-gdb-set disassembly-flavor intel",
          "ignoreFailures": true
        }
      ],
      "logging": {
        "moduleLoad": false,
        "trace": false,
        "engineLogging": false,
        "programOutput": true,
        "exceptions": true
      }
    },
    {
      "name": "GDB: Debug Unit Test",
      "type": "cppdbg",
      "request": "launch",
      "preLaunchTask": "Test: Run Unit Tests",
      "program": "${workspaceFolder}/build_ut/test/ut/mssanitizer_test",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build_ut",
      "environment": [
        {
          "name": "LD_LIBRARY_PATH",
          "value": "${workspaceFolder}/build_ut:${env:LD_LIBRARY_PATH}"
        },
        {
          "name": "LD_PRELOAD_PATH",
          "value": "${workspaceFolder}/output/lib64"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "为 gdb 启用整齐打印",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "设置反汇编风格为 Intel",
          "text": "-gdb-set disassembly-flavor intel",
          "ignoreFailures": true
        }
      ],
      "logging": {
        "moduleLoad": false,
        "trace": false,
        "engineLogging": false,
        "programOutput": true,
        "exceptions": true
      }
    }
  ],
  "inputs": [
    {
        "id": "toolType",
        "type": "promptString",
        "description": "请输入检测工具类型 (例如: memcheck, helgrind)",
        "default": "memcheck"
    },
    {
        "id": "scriptPath",
        "type": "promptString",
        "description": "请输入要运行的脚本路径 (例如: run.sh)",
        "default": "run.sh"
    }
  ]
}
