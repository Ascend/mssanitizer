/* !
 * \file initcheck_multiscene.asc
 * \brief 未初始化检测多场景样例，演示 mssanitizer 对 GM/UB 上未初始化读取的检测和定位
 */
#include "acl/acl.h"
#include "kernel_operator.h"

// 场景一：Global Memory（GM）未初始化读取
// 分配 GM 内存后不对 y 做初始化，算子内读取 y 时将触发未初始化告警
template <uint32_t blockLength>
__vector__ __global__ void gm_uninit_demo(__gm__ float* x, __gm__ float* y, __gm__ float* z)
{
    AscendC::InitSocState();

    AscendC::GlobalTensor<float> xGm, yGm, zGm;
    xGm.SetGlobalBuffer(x, blockLength);
    yGm.SetGlobalBuffer(y, blockLength);
    zGm.SetGlobalBuffer(z, blockLength);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAlloc;
    AscendC::LocalTensor<float> xLocal = ubAlloc.Alloc<float, blockLength>();
    AscendC::LocalTensor<float> yLocal = ubAlloc.Alloc<float, blockLength>();
    AscendC::LocalTensor<float> zLocal = ubAlloc.Alloc<float, blockLength>();

    // x 正常搬入（GM 已初始化）
    AscendC::DataCopy(xLocal, xGm, blockLength);

    // y 搬入 —— 但 main() 中有意未对 devY 做 aclrtMemset，此处将读取未初始化的 GM
    AscendC::DataCopy(yLocal, yGm, blockLength);
    AscendC::PipeBarrier<PIPE_ALL>();

    AscendC::Add(zLocal, xLocal, yLocal, blockLength);
    AscendC::PipeBarrier<PIPE_ALL>();

    AscendC::DataCopy(zGm, zLocal, blockLength);
    AscendC::PipeBarrier<PIPE_ALL>();
}

// 场景二：Unified Buffer（UB）未初始化读取
// 分配 UB tensor 后不对 yLocal 写入数据，Add 读取 yLocal 时将触发未初始化告警
template <uint32_t blockLength>
__vector__ __global__ void ub_uninit_demo(__gm__ float* x, __gm__ float* z)
{
    AscendC::InitSocState();

    AscendC::GlobalTensor<float> xGm, zGm;
    xGm.SetGlobalBuffer(x, blockLength);
    zGm.SetGlobalBuffer(z, blockLength);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAlloc;
    AscendC::LocalTensor<float> xLocal = ubAlloc.Alloc<float, blockLength>();
    AscendC::LocalTensor<float> yLocal = ubAlloc.Alloc<float, blockLength>();
    AscendC::LocalTensor<float> zLocal = ubAlloc.Alloc<float, blockLength>();

    // x 从 GM 搬入 UB（正常初始化）
    AscendC::DataCopy(xLocal, xGm, blockLength);

    // yLocal 仅分配 UB 空间，但未通过 DataCopy 或其他方式写入数据
    // 后续 Add 读取 yLocal 时将访问 UB 上的未初始化内存
    AscendC::PipeBarrier<PIPE_ALL>();

    // Add 读取 xLocal（已初始化）和 yLocal（未初始化！），触发 UB 未初始化告警
    AscendC::Add(zLocal, xLocal, yLocal, blockLength);
    AscendC::PipeBarrier<PIPE_ALL>();

    AscendC::DataCopy(zGm, zLocal, blockLength);
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t blockLength = 256;
    size_t bufBytes = blockLength * sizeof(float);

    aclInit(nullptr);

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // 场景一：GM 未初始化读取
    // devY 分配后不调用 aclrtMemset，算子内 DataCopy 读取 devY 时将触发告警
    {
        float* devX = nullptr;
        float* devY = nullptr;
        float* devZ = nullptr;

        aclrtMalloc((void**)&devX, bufBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc((void**)&devY, bufBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc((void**)&devZ, bufBytes, ACL_MEM_MALLOC_HUGE_FIRST);

        // 仅初始化 devX，devY 有意不初始化
        aclrtMemset(devX, bufBytes, 0, bufBytes);

        gm_uninit_demo<blockLength><<<1, nullptr, stream>>>(devX, devY, devZ);
        aclrtSynchronizeStream(stream);

        aclrtFree(devX);
        aclrtFree(devY);
        aclrtFree(devZ);
    }

    // 场景二：UB 未初始化读取
    // 算子内分配 UB tensor 但不对 yLocal 写入，Add 读取 yLocal 时触发告警
    {
        float* devX = nullptr;
        float* devZ = nullptr;

        aclrtMalloc((void**)&devX, bufBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc((void**)&devZ, bufBytes, ACL_MEM_MALLOC_HUGE_FIRST);

        aclrtMemset(devX, bufBytes, 0, bufBytes);

        ub_uninit_demo<blockLength><<<1, nullptr, stream>>>(devX, devZ);
        aclrtSynchronizeStream(stream);

        aclrtFree(devX);
        aclrtFree(devZ);
    }

    aclrtDestroyStream(stream);

    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
