/* !
 * \file racecheck_advanced.asc
 * \brief mssanitizer WAW/WAR/RAW 流水间、核间和卡间数据竞争检测样例
 */
#include <cstdio>
#include <cstring>

#include "ms_tools_ext.h"
#include "acl/acl.h"
#include "kernel_operator.h"

namespace {

constexpr uint32_t kElementsPerRegion = 256;
constexpr uint32_t kRegionCount = 3;
constexpr size_t kBufferBytes = kElementsPerRegion * kRegionCount * sizeof(float);
// aclrtMemP2PMap 以 2 MiB 粒度映射共享 GM。
constexpr size_t kCrossNpuBufferBytes = 2 * 1024 * 1024;

bool CheckAcl(aclError ret, const char *expression) {
    if (ret == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "[ERROR] %s failed, ret=%d\n", expression, static_cast<int32_t>(ret));
    return false;
}

bool RegisterSharedRegion(void *ptr, size_t size, uint32_t deviceId, mstxMemRegionHandle_t &handle) {
    uint64_t toolId = MSTX_TOOL_INVALID_ID;
    mstxGetToolId(&toolId);
    if (toolId != MSTX_TOOL_MSSANITIZER_ID) {
        std::fprintf(stderr, "[ERROR] mssanitizer MSTX injection is not active, toolId=0x%lx\n", toolId);
        return false;
    }

    mstxMemVirtualRangeDesc_t range{};
    range.deviceId = deviceId;
    range.ptr = ptr;
    range.size = size;
    mstxMemRegionsRegisterBatch_t regions{};
    regions.regionType = MSTX_MEM_TYPE_VIRTUAL_ADDRESS;
    regions.regionCount = 1;
    regions.regionDescArray = &range;
    regions.regionHandleArrayOut = &handle;
    mstxMemRegionsRegister(globalDomain, &regions);
    if (handle == nullptr) {
        std::fprintf(stderr, "[ERROR] mstxMemRegionsRegister did not return a region handle\n");
        return false;
    }

    mstxMemPermissionsAssignRegionsDesc_t permission{};
    permission.flags = MSTX_MEM_PERMISSIONS_REGION_FLAGS_READ | MSTX_MEM_PERMISSIONS_REGION_FLAGS_WRITE |
        MSTX_MEM_PERMISSIONS_REGION_FLAGS_SHARED;
    permission.region.refType = MSTX_MEM_REGION_REF_TYPE_HANDLE;
    permission.region.handle = handle;
    mstxMemPermissionsAssignBatch_t permissions{};
    permissions.regionCount = 1;
    permissions.regionDescArray = &permission;
    mstxMemPermissionsAssign(globalDomain, &permissions);
    return true;
}

void UnregisterSharedRegion(mstxMemRegionHandle_t handle) {
    if (handle == nullptr) {
        return;
    }
    mstxMemRegionRef_t region{};
    region.refType = MSTX_MEM_REGION_REF_TYPE_HANDLE;
    region.handle = handle;
    mstxMemRegionsUnregisterBatch_t regions{};
    regions.refCount = 1;
    regions.refArray = &region;
    mstxMemRegionsUnregister(globalDomain, &regions);
}

class HazardRegions {
public:
    __aicore__ inline void Init(GM_ADDR buf) {
        __gm__ float *base = (__gm__ float *)buf;
        waw_.SetGlobalBuffer(base, kElementsPerRegion);
        raw_.SetGlobalBuffer(base + kElementsPerRegion, kElementsPerRegion);
        war_.SetGlobalBuffer(base + kElementsPerRegion * 2, kElementsPerRegion);
    }

    __aicore__ inline void PipelineHazards() {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAlloc;
        AscendC::LocalTensor<float> local = ubAlloc.Alloc<float, kElementsPerRegion>();

        // PIPE_S 和 PIPE_MTE3 未同步写入同一 GM，构成 WAW。
        waw_.SetValue(0, 1.0f);
        AscendC::DataCopy(waw_, local, kElementsPerRegion);

        // PIPE_S 写后 PIPE_MTE2 读，缺少 S_MTE2 同步，构成 RAW。
        raw_.SetValue(0, 2.0f);
        AscendC::DataCopy(local, raw_, kElementsPerRegion);

        // PIPE_MTE2 读后 PIPE_S 写，缺少 MTE2_S 同步，构成 WAR。
        AscendC::DataCopy(local, war_, kElementsPerRegion);
        war_.SetValue(0, 3.0f);
    }

    __aicore__ inline void PeerHazards(uint32_t role) {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAlloc;
        AscendC::LocalTensor<float> local0 = ubAlloc.Alloc<float, kElementsPerRegion>();
        AscendC::LocalTensor<float> local1 = ubAlloc.Alloc<float, kElementsPerRegion>();

        if (role == 0) {
            waw_.SetValue(0, 10.0f);
            raw_.SetValue(0, 20.0f);
            AscendC::DataCopy(local0, war_, kElementsPerRegion);
        } else {
            AscendC::DataCopy(waw_, local0, kElementsPerRegion);
            AscendC::DataCopy(local1, raw_, kElementsPerRegion);
            war_.SetValue(0, 30.0f);
        }
    }

private:
    AscendC::GlobalTensor<float> waw_;
    AscendC::GlobalTensor<float> raw_;
    AscendC::GlobalTensor<float> war_;
};

} // namespace

__global__ __vector__ void pipeline_hazards(GM_ADDR buf) {
    AscendC::InitSocState();
    HazardRegions regions;
    regions.Init(buf);
    regions.PipelineHazards();
}

__global__ __vector__ void pipeline_raw_hazard(GM_ADDR buf) {
    AscendC::InitSocState();
    AscendC::GlobalTensor<float> gmBuf;
    gmBuf.SetGlobalBuffer((__gm__ float *)buf, kElementsPerRegion);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAlloc;
    AscendC::LocalTensor<float> local = ubAlloc.Alloc<float, kElementsPerRegion>();

    uint32_t blockIdx = AscendC::GetBlockIdx();
    gmBuf.SetValue(blockIdx, 4.0f);
    AscendC::DataCopy(local, gmBuf, kElementsPerRegion);
}

__global__ __vector__ void cross_core_hazards(GM_ADDR buf) {
    AscendC::InitSocState();
    HazardRegions regions;
    regions.Init(buf);
    regions.PeerHazards(AscendC::GetBlockIdx());
}

__global__ __vector__ void cross_npu_hazards(GM_ADDR buf, uint32_t role) {
    AscendC::InitSocState();
    HazardRegions regions;
    regions.Init(buf);
    regions.PeerHazards(role);
}

namespace {

int RunSingleNpu(const char *mode) {
    constexpr int32_t deviceId = 0;
    int32_t result = 1;
    bool deviceReady = false;
    aclrtStream stream = nullptr;
    void *devBuf = nullptr;

    do {
        if (!CheckAcl(aclrtSetDevice(deviceId), "aclrtSetDevice(deviceId)")) {
            break;
        }
        deviceReady = true;
        if (!CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream(&stream)")) {
            break;
        }
        if (!CheckAcl(aclrtMalloc(&devBuf, kBufferBytes, ACL_MEM_MALLOC_HUGE_FIRST),
                "aclrtMalloc(&devBuf, kBufferBytes, ACL_MEM_MALLOC_HUGE_FIRST)")) {
            break;
        }
        if (!CheckAcl(aclrtMemset(devBuf, kBufferBytes, 0, kBufferBytes),
                "aclrtMemset(devBuf, kBufferBytes, 0, kBufferBytes)")) {
            break;
        }

        if (std::strcmp(mode, "pipeline") == 0) {
            pipeline_hazards<<<1, nullptr, stream>>>(static_cast<uint8_t *>(devBuf));
            pipeline_raw_hazard<<<2, nullptr, stream>>>(static_cast<uint8_t *>(devBuf));
        } else {
            cross_core_hazards<<<2, nullptr, stream>>>(static_cast<uint8_t *>(devBuf));
        }
        if (!CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream(stream)")) {
            break;
        }
        result = 0;
    } while (false);

    if (devBuf != nullptr && !CheckAcl(aclrtFree(devBuf), "aclrtFree(devBuf)")) {
        result = 1;
    }
    if (stream != nullptr && !CheckAcl(aclrtDestroyStream(stream), "aclrtDestroyStream(stream)")) {
        result = 1;
    }
    if (deviceReady && !CheckAcl(aclrtResetDevice(deviceId), "aclrtResetDevice(deviceId)")) {
        result = 1;
    }
    return result;
}

bool EnablePeerAccess(int32_t srcDevice, int32_t dstDevice) {
    int32_t canAccessPeer = 0;
    if (!CheckAcl(aclrtDeviceCanAccessPeer(&canAccessPeer, srcDevice, dstDevice),
            "aclrtDeviceCanAccessPeer(&canAccessPeer, srcDevice, dstDevice)")) {
        return false;
    }
    if (canAccessPeer == 0) {
        std::fprintf(stderr, "[ERROR] device %d cannot access peer device %d\n", srcDevice, dstDevice);
        return false;
    }
    return CheckAcl(aclrtDeviceEnablePeerAccess(dstDevice, 0), "aclrtDeviceEnablePeerAccess(dstDevice, 0)");
}

int RunCrossNpu() {
    constexpr int32_t ownerDevice = 0;
    constexpr int32_t peerDevice = 1;
    int32_t result = 1;
    bool aclReady = false;
    bool ownerReady = false;
    bool peerReady = false;
    bool ownerPeerAccess = false;
    bool peerOwnerAccess = false;
    aclrtStream ownerStream = nullptr;
    aclrtStream peerStream = nullptr;
    void *sharedBuf = nullptr;
    mstxMemRegionHandle_t ownerRegion = nullptr;
    mstxMemRegionHandle_t peerRegion = nullptr;

    do {
        if (!CheckAcl(aclInit(nullptr), "aclInit(nullptr)")) {
            break;
        }
        aclReady = true;

        if (!CheckAcl(aclrtSetDevice(ownerDevice), "aclrtSetDevice(ownerDevice)")) {
            break;
        }
        ownerReady = true;
        if (!EnablePeerAccess(ownerDevice, peerDevice)) {
            break;
        }
        ownerPeerAccess = true;

        if (!CheckAcl(aclrtSetDevice(peerDevice), "aclrtSetDevice(peerDevice)")) {
            break;
        }
        peerReady = true;
        if (!EnablePeerAccess(peerDevice, ownerDevice)) {
            break;
        }
        peerOwnerAccess = true;
        if (!CheckAcl(aclrtCreateStream(&peerStream), "aclrtCreateStream(&peerStream)")) {
            break;
        }

        if (!CheckAcl(aclrtSetDevice(ownerDevice), "aclrtSetDevice(ownerDevice)")) {
            break;
        }
        if (!CheckAcl(aclrtCreateStream(&ownerStream), "aclrtCreateStream(&ownerStream)")) {
            break;
        }
        if (!CheckAcl(aclrtMalloc(&sharedBuf, kCrossNpuBufferBytes, ACL_MEM_MALLOC_HUGE_FIRST),
                "aclrtMalloc(&sharedBuf, kCrossNpuBufferBytes, ACL_MEM_MALLOC_HUGE_FIRST)")) {
            break;
        }
        if (!CheckAcl(aclrtMemset(sharedBuf, kCrossNpuBufferBytes, 0, kCrossNpuBufferBytes),
                "aclrtMemset(sharedBuf, kCrossNpuBufferBytes, 0, kCrossNpuBufferBytes)")) {
            break;
        }
        if (!CheckAcl(aclrtMemP2PMap(sharedBuf, kCrossNpuBufferBytes, peerDevice, 0),
                "aclrtMemP2PMap(sharedBuf, kCrossNpuBufferBytes, peerDevice, 0)")) {
            break;
        }
        if (!RegisterSharedRegion(sharedBuf, kCrossNpuBufferBytes, ownerDevice, ownerRegion)) {
            break;
        }

        if (!CheckAcl(aclrtSetDevice(peerDevice), "aclrtSetDevice(peerDevice)")) {
            break;
        }
        if (!RegisterSharedRegion(sharedBuf, kCrossNpuBufferBytes, peerDevice, peerRegion)) {
            break;
        }

        if (!CheckAcl(aclrtSetDevice(ownerDevice), "aclrtSetDevice(ownerDevice)")) {
            break;
        }
        cross_npu_hazards<<<1, nullptr, ownerStream>>>(static_cast<uint8_t *>(sharedBuf), 0);

        if (!CheckAcl(aclrtSetDevice(peerDevice), "aclrtSetDevice(peerDevice)")) {
            break;
        }
        cross_npu_hazards<<<1, nullptr, peerStream>>>(static_cast<uint8_t *>(sharedBuf), 1);
        if (!CheckAcl(aclrtSynchronizeStream(peerStream), "aclrtSynchronizeStream(peerStream)")) {
            break;
        }

        if (!CheckAcl(aclrtSetDevice(ownerDevice), "aclrtSetDevice(ownerDevice)")) {
            break;
        }
        if (!CheckAcl(aclrtSynchronizeStream(ownerStream), "aclrtSynchronizeStream(ownerStream)")) {
            break;
        }
        result = 0;
    } while (false);

    if (peerReady) {
        if (CheckAcl(aclrtSetDevice(peerDevice), "aclrtSetDevice(peerDevice) for cleanup")) {
            UnregisterSharedRegion(peerRegion);
            if (peerStream != nullptr && !CheckAcl(aclrtDestroyStream(peerStream), "aclrtDestroyStream(peerStream)")) {
                result = 1;
            }
            if (peerOwnerAccess &&
                !CheckAcl(aclrtDeviceDisablePeerAccess(ownerDevice), "aclrtDeviceDisablePeerAccess(ownerDevice)")) {
                result = 1;
            }
            if (!CheckAcl(aclrtResetDevice(peerDevice), "aclrtResetDevice(peerDevice)")) {
                result = 1;
            }
        } else {
            result = 1;
        }
    }

    if (ownerReady) {
        if (CheckAcl(aclrtSetDevice(ownerDevice), "aclrtSetDevice(ownerDevice) for cleanup")) {
            UnregisterSharedRegion(ownerRegion);
            if (sharedBuf != nullptr && !CheckAcl(aclrtFree(sharedBuf), "aclrtFree(sharedBuf)")) {
                result = 1;
            }
            if (ownerStream != nullptr &&
                !CheckAcl(aclrtDestroyStream(ownerStream), "aclrtDestroyStream(ownerStream)")) {
                result = 1;
            }
            if (ownerPeerAccess &&
                !CheckAcl(aclrtDeviceDisablePeerAccess(peerDevice), "aclrtDeviceDisablePeerAccess(peerDevice)")) {
                result = 1;
            }
            if (!CheckAcl(aclrtResetDevice(ownerDevice), "aclrtResetDevice(ownerDevice)")) {
                result = 1;
            }
        } else {
            result = 1;
        }
    }

    if (aclReady && !CheckAcl(aclFinalize(), "aclFinalize()")) {
        result = 1;
    }
    return result;
}

void PrintUsage(const char *program) { std::fprintf(stderr, "Usage: %s pipeline|cross-core|cross-npu\n", program); }

} // namespace

int32_t main(int32_t argc, char *argv[]) {
    if (argc != 2) {
        PrintUsage(argv[0]);
        return 1;
    }

    if (std::strcmp(argv[1], "cross-npu") == 0) {
        return RunCrossNpu();
    }
    if (std::strcmp(argv[1], "pipeline") != 0 && std::strcmp(argv[1], "cross-core") != 0) {
        PrintUsage(argv[0]);
        return 1;
    }

    if (!CheckAcl(aclInit(nullptr), "aclInit(nullptr)")) {
        return 1;
    }
    int32_t ret = RunSingleNpu(argv[1]);
    if (!CheckAcl(aclFinalize(), "aclFinalize()")) {
        return 1;
    }
    return ret;
}
