/* !
 * \file memcheck_advanced.asc
 * \brief mssanitizer 多核踩踏、L1 异常、非对齐、非法释放、内存泄漏和分配未使用检测样例
 */
#include <cstdio>
#include <cstring>

#include "acl.h"
#include "kernel_operator.h"

namespace {

constexpr int32_t kDeviceId = 0;
constexpr uint32_t kElements = 256;
constexpr uint32_t kL1Elements = 64;
constexpr size_t kKernelBufferBytes = (kElements + 8) * sizeof(float);
constexpr size_t kHostBufferBytes = kElements * sizeof(float);

bool CheckAcl(aclError ret, const char *expression) {
    if (ret == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "[ERROR] %s failed, ret=%d\n", expression, static_cast<int32_t>(ret));
    return false;
}

struct RuntimeResources {
    bool deviceReady = false;
    aclrtStream stream = nullptr;
    void *devBuf = nullptr;
};

bool PrepareResources(RuntimeResources &resources, size_t bytes) {
    if (!CheckAcl(aclrtSetDevice(kDeviceId), "aclrtSetDevice(kDeviceId)")) {
        return false;
    }
    resources.deviceReady = true;
    if (!CheckAcl(aclrtCreateStream(&resources.stream), "aclrtCreateStream(&resources.stream)")) {
        return false;
    }
    return CheckAcl(aclrtMalloc(&resources.devBuf, bytes, ACL_MEM_MALLOC_HUGE_FIRST),
        "aclrtMalloc(&resources.devBuf, bytes, ACL_MEM_MALLOC_HUGE_FIRST)");
}

int32_t CleanupResources(RuntimeResources &resources, bool freeBuffer, bool resetDevice) {
    int32_t result = 0;
    if (freeBuffer && resources.devBuf != nullptr) {
        if (!CheckAcl(aclrtFree(resources.devBuf), "aclrtFree(resources.devBuf)")) {
            result = 1;
        }
        resources.devBuf = nullptr;
    }
    if (resources.stream != nullptr) {
        if (!CheckAcl(aclrtDestroyStream(resources.stream), "aclrtDestroyStream(resources.stream)")) {
            result = 1;
        }
        resources.stream = nullptr;
    }
    if (resetDevice && resources.deviceReady) {
        if (!CheckAcl(aclrtResetDevice(kDeviceId), "aclrtResetDevice(kDeviceId)")) {
            result = 1;
        }
        resources.deviceReady = false;
    }
    return result;
}

} // namespace

__global__ __vector__ void multi_core_stomp(GM_ADDR buf) {
    AscendC::InitSocState();
    AscendC::GlobalTensor<float> output;
    output.SetGlobalBuffer((__gm__ float *)buf, kElements);

    // 两个 block 故意写入同一 GM 地址，后写入的核会踩踏首个核拥有的区域。
    output.SetValue(0, static_cast<float>(AscendC::GetBlockIdx() + 1));
}

__global__ __vector__ void misaligned_access(GM_ADDR buf) {
    AscendC::InitSocState();
    AscendC::GlobalTensor<float> input;
    input.SetGlobalBuffer((__gm__ float *)buf, kElements);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAlloc;
    AscendC::LocalTensor<float> storage = ubAlloc.Alloc<float, kElements + 1>();
    AscendC::LocalTensor<float> misaligned = storage[1];

    // UB 首地址偏移 4 字节，故意破坏普通 DMA 要求的 32 字节对齐。
    AscendC::DataCopy(misaligned, input, kElements);
}

__global__ __cube__ void l1_out_of_bounds(GM_ADDR buf) {
    AscendC::InitSocState();
    AscendC::GlobalTensor<float> input;
    input.SetGlobalBuffer((__gm__ float *)buf, kElements);

    AscendC::LocalMemAllocator<AscendC::Hardware::L1> l1Alloc;
    AscendC::LocalTensor<float> l1Buffer = l1Alloc.Alloc<float, kL1Elements>();

    // L1 只分配 kL1Elements 个 float，却从 GM 搬入 kElements 个元素，故意越界写入 L1。
    AscendC::DataCopy(l1Buffer, input, kElements);
}

__global__ __cube__ void l1_read_out_of_bounds(GM_ADDR buf) {
    AscendC::InitSocState();
    AscendC::GlobalTensor<float> buffer;
    buffer.SetGlobalBuffer((__gm__ float *)buf, kElements);

    AscendC::LocalMemAllocator<AscendC::Hardware::L1> l1Alloc;
    AscendC::LocalTensor<float> l1Buffer = l1Alloc.Alloc<float, kL1Elements>();

    // 先初始化合法范围，再从只有 kL1Elements 个元素的 L1 中搬出 kElements 个元素。
    AscendC::DataCopy(l1Buffer, buffer, kL1Elements);
    AscendC::DataCopy(buffer, l1Buffer, kElements);
}

__global__ __cube__ void l1_misaligned_access(GM_ADDR buf) {
    AscendC::InitSocState();
    AscendC::GlobalTensor<float> input;
    input.SetGlobalBuffer((__gm__ float *)buf, kElements);

    AscendC::LocalMemAllocator<AscendC::Hardware::L1> l1Alloc;
    AscendC::LocalTensor<float> storage = l1Alloc.Alloc<float, kElements + 1>();
    AscendC::LocalTensor<float> misaligned = storage[1];

    // L1 首地址偏移 4 字节，但剩余容量仍覆盖搬运量，因此只触发非对齐访问。
    AscendC::DataCopy(misaligned, input, kElements);
}

namespace {

int32_t RunKernelScenario(const char *mode) {
    RuntimeResources resources;
    int32_t result = 1;
    do {
        if (!PrepareResources(resources, kKernelBufferBytes)) {
            break;
        }
        if (!CheckAcl(aclrtMemset(resources.devBuf, kKernelBufferBytes, 0, kKernelBufferBytes),
                "aclrtMemset(resources.devBuf, kKernelBufferBytes, 0, kKernelBufferBytes)")) {
            break;
        }

        if (std::strcmp(mode, "multi-core") == 0) {
            multi_core_stomp<<<2, nullptr, resources.stream>>>(static_cast<uint8_t *>(resources.devBuf));
        } else if (std::strcmp(mode, "l1-oob") == 0) {
            l1_out_of_bounds<<<1, nullptr, resources.stream>>>(static_cast<uint8_t *>(resources.devBuf));
        } else if (std::strcmp(mode, "l1-oob-read") == 0) {
            l1_read_out_of_bounds<<<1, nullptr, resources.stream>>>(static_cast<uint8_t *>(resources.devBuf));
        } else if (std::strcmp(mode, "l1-misaligned") == 0) {
            l1_misaligned_access<<<1, nullptr, resources.stream>>>(static_cast<uint8_t *>(resources.devBuf));
        } else {
            misaligned_access<<<1, nullptr, resources.stream>>>(static_cast<uint8_t *>(resources.devBuf));
        }
        if (!CheckAcl(aclrtSynchronizeStream(resources.stream), "aclrtSynchronizeStream(resources.stream)")) {
            break;
        }
        result = 0;
    } while (false);

    if (CleanupResources(resources, true, true) != 0) {
        result = 1;
    }
    return result;
}

int32_t RunIllegalFree() {
    RuntimeResources resources;
    int32_t result = 1;
    do {
        if (!PrepareResources(resources, kHostBufferBytes)) {
            break;
        }
        if (!CheckAcl(aclrtMemset(resources.devBuf, kHostBufferBytes, 0, kHostBufferBytes),
                "aclrtMemset(resources.devBuf, kHostBufferBytes, 0, kHostBufferBytes)")) {
            break;
        }
        void *freedBuf = resources.devBuf;
        if (!CheckAcl(aclrtFree(freedBuf), "aclrtFree(freedBuf)")) {
            break;
        }
        resources.devBuf = nullptr;

        // 故意二次释放。返回值不是验收依据，检测报告中的 illegal free 才是。
        (void)aclrtFree(freedBuf);
        result = 0;
    } while (false);

    if (CleanupResources(resources, true, true) != 0) {
        result = 1;
    }
    return result;
}

int32_t RunLeak() {
    RuntimeResources resources;
    int32_t result = 1;
    bool leakArmed = false;
    do {
        if (!PrepareResources(resources, kHostBufferBytes)) {
            break;
        }
        if (!CheckAcl(aclrtMemset(resources.devBuf, kHostBufferBytes, 0, kHostBufferBytes),
                "aclrtMemset(resources.devBuf, kHostBufferBytes, 0, kHostBufferBytes)")) {
            break;
        }
        // 故意不释放已初始化的 GM，也不 reset Device，让 leak-check 在进程退出时报告。
        leakArmed = true;
        result = 0;
    } while (false);

    if (CleanupResources(resources, !leakArmed, !leakArmed) != 0) {
        result = 1;
    }
    return result;
}

int32_t RunUnusedMemory() {
    RuntimeResources resources;
    int32_t result = 1;
    do {
        if (!PrepareResources(resources, kHostBufferBytes)) {
            break;
        }

        // 分配后不执行 memset、kernel 读写或 memcpy，释放时应报告整段内存未使用。
        result = 0;
    } while (false);

    if (CleanupResources(resources, true, true) != 0) {
        result = 1;
    }
    return result;
}

void PrintUsage(const char *program) {
    std::fprintf(stderr,
        "Usage: %s multi-core|l1-oob|l1-oob-read|l1-misaligned|misaligned|illegal-free|leak|unused\n",
        program);
}

} // namespace

int32_t main(int32_t argc, char *argv[]) {
    if (argc != 2) {
        PrintUsage(argv[0]);
        return 1;
    }

    const char *mode = argv[1];
    if (std::strcmp(mode, "multi-core") != 0 && std::strcmp(mode, "l1-oob") != 0 &&
        std::strcmp(mode, "l1-oob-read") != 0 && std::strcmp(mode, "l1-misaligned") != 0 &&
        std::strcmp(mode, "misaligned") != 0 && std::strcmp(mode, "illegal-free") != 0 &&
        std::strcmp(mode, "leak") != 0 && std::strcmp(mode, "unused") != 0) {
        PrintUsage(argv[0]);
        return 1;
    }

    if (!CheckAcl(aclInit(nullptr), "aclInit(nullptr)")) {
        return 1;
    }

    int32_t result = 1;
    if (std::strcmp(mode, "multi-core") == 0 || std::strcmp(mode, "l1-oob") == 0 ||
        std::strcmp(mode, "l1-oob-read") == 0 || std::strcmp(mode, "l1-misaligned") == 0 ||
        std::strcmp(mode, "misaligned") == 0) {
        result = RunKernelScenario(mode);
    } else if (std::strcmp(mode, "illegal-free") == 0) {
        result = RunIllegalFree();
    } else if (std::strcmp(mode, "leak") == 0) {
        result = RunLeak();
    } else {
        result = RunUnusedMemory();
    }

    if (!CheckAcl(aclFinalize(), "aclFinalize()")) {
        return 1;
    }
    return result;
}
